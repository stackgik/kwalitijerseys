{
  "name": "kwaliti_jersey",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "db:seed": "tsx --env-file=.env.local app/db/seed.ts",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:push:staging": "dotenv -e .env.staging -- drizzle-kit push",
    "db:push:prod": "dotenv -e .env.production -- drizzle-kit push",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:migrate:staging": "dotenv -e .env.staging -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e .env.production -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:studio:staging": "dotenv -e .env.staging -- drizzle-kit studio",
    "build": "next build",
    "build:staging": "dotenv -e .env.staging -- next build",
    "build:prod": "dotenv -e .env.production -- next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.7",
    "@hookform/resolvers": "^5.2.2",
    "@paystack/inline-js": "^2.23.1",
    "@sentry/nextjs": "^10.66.0",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.564.0",
    "nanoid": "^5.1.16",
    "next": "^16.1.6",
    "next-cloudinary": "^6.17.5",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/paystack__inline-js": "^1.0.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
